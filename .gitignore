/benzene_*.npz

# Deprecated code bucket
/deprecated/

# Local handoff notes and presentation drafts (not engine code)
/handoff.txt
/.handoff-task50.txt
/demo-talk/


# grid run artifacts (regenerated; out/ is large + actively written)
benchmarks/grid/out/
benchmarks/grid/geoms/
benchmarks/grid/toml/
benchmarks/grid/*.log
benchmarks/grid/status.json
benchmarks/gmtkn30/__pycache__/
benchmarks/grid/__pycache__/

# omega_diag / gmtkn30 sweep artifacts: raw per-job stdout+err, timestamped
# logs, and scratch derisk output are regenerable from the committed drivers +
# TOMLs — keep only the drivers, curated results (*.md / results *.json), and
# reproducible inputs. Same policy as benchmarks/grid/ above and scripts/README.md.
benchmarks/omega_diag/out/
benchmarks/omega_diag/terfc_out/
benchmarks/omega_diag/derisk/out/
benchmarks/omega_diag/**/*.log
benchmarks/omega_diag/*.log
benchmarks/gmtkn30/out/
benchmarks/gmtkn30/*.log
benchmarks/**/__pycache__/
# Per-job TOMLs are generated by the runner scripts at launch (same as
# benchmarks/grid/toml/ above) — regenerable, keep only the drivers + source
# geometries + curated results (*.md / results *.json).
benchmarks/gmtkn30/toml/
benchmarks/omega_diag/toml/
benchmarks/omega_diag/derisk/toml/
benchmarks/omega_diag/validate/*.toml
# latex build products

# Python bytecode — everywhere
__pycache__/
*.pyc

# Scratch zone: load-gated queue stdout, one-off probes, debug logs.
# Promote a file into the permanent record deliberately with `git add -f`.
scripts/queue/out/
scripts/**/*.log

# Experimental parking lot: salvaged drivers/probes kept out of the build and
# out of version control (e.g. c9_driver.rs). Promote deliberately with add -f.
experimental/

# GFN-FF writes this topology cache into the CWD at runtime.
gfnff_topo

# local docs (moved out of git 2026-08-07; shared via wiki instead)
/wiki/

# local Claude Code project instructions (internal, not shared)
/CLAUDE.md
