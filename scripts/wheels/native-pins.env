# Source pins of the macOS/Windows native deps (KEY=VALUE, no quoting, no
# spaces). Read by .github/workflows/native-deps-macwin.yml (which builds and
# caches the deps) and scripts/wheels/native-cache-key.sh (which every
# consumer, e.g. platform-tests.yml, uses to find those caches). One file, so
# the builder and its readers cannot disagree on a key.
#
# libint2: ferric's small export, the same as wheels.yml's Linux native deps.
LIBINT_VERSION=2.7.2
LIBINT_URL=https://github.com/mgoldey/ferric/releases/download/libint-2.7.2-ferric-small-1/libint-2.7.2-ferric-small-1.tgz
LIBINT_SHA256=123b744cd744b19c4ca8401b3a58ed7fca3680bc638519edd806501b5919a48b  # pragma: allowlist secret
# OpenBLAS differs per platform. macOS keeps the Linux wheels' 0.3.27.
# Windows needs a newer one: its build is clang-cl (MSVC ABI) with NOFORTRAN +
# C_LAPACK, and OpenBLAS fixed bugs in exactly that configuration after 0.3.27
# (Changelog.txt): 0.3.30 "fixed several errors in the C code replacements for
# the complex and double precision complex LAPACK functions that get used
# (only) when compiling with Microsoft C and NOFORTRAN=1 under MS Windows",
# 0.3.32 "Fixed an ABI mismatch in the internal version of CDOT/ZDOT used by
# the C fallback versions of the LAPACK source", and 0.3.28 reverted Windows
# thread management "due to signs of race conditions". With 0.3.27 the Windows
# wheel gave wrong complex (k-point PBC) results; complex_lapack_abi.rs
# catches it.
OPENBLAS_VERSION_MACOS=0.3.27
OPENBLAS_VERSION_WINDOWS=0.3.34
LIBXC_VERSION=6.2.2
EIGEN_VERSION=3.4.0
# Bump to drop every cache entry native-deps-macwin.yml writes.
NATIVE_MACWIN_CACHE_VERSION=v1
