#!/usr/bin/env bash
# box-lease: let a timing job own the box; cargo builds and tests wait for it.
#
#   box-lease run --label NAME [--wait-secs N] [--max-hold N] -- CMD...
#   box-lease wait [--wait-secs N]    block until no lease is pending or held
#   box-lease status
#
# `run` takes, in this order: the lease, the gate's cargo lock, both heavy slots. It waits for
# whatever is in flight to finish, then runs CMD holding all four, and returns CMD's status (75 if
# the wait expired and CMD never ran). The order is load-bearing: the gate holds the cargo lock
# while its cargo takes a slot, so a lease holding a slot while waiting on the cargo lock would
# deadlock. The lease comes first so that new compiles (scripts/cargo-shim) queue behind a pending
# lease rather than starving it.
#
# These are kernel flocks on fds only this script holds, so they vanish with this process and cannot
# go stale, and CMD gets them closed, so a daemon it spawns (sccache) cannot squat them. Hence:
#   - `kill -9` of THIS process frees the box while CMD runs on, orphaned. Plain TERM/INT/HUP are
#     forwarded to CMD and the lease is held until CMD exits.
#   - --max-hold only warns. Nothing here ever kills a job for holding too long.
#   - $LEASE.info holds label/pid/start for messages. It is never consulted to decide anything.
#
# COVERS cargo through the shim (including `cargo test`, whose whole run is under the lock) and
# anything wrapped in `flock -o /tmp/ferric-compile.lock`. DOES NOT COVER a test binary, pytest or
# python started directly: put `box-lease wait` first in such a script. Nor other sessions or
# non-cargo load; a bench's own load gate stays. Under a lease, cargo runs straight through, but
# CMD must not itself `flock` a compile lock: that lock is held by its own lease.
set -uo pipefail

LOCK_DIR=${FERRIC_LOCK_DIR:-/tmp}
LEASE=$LOCK_DIR/ferric-box.lease
INFO=$LEASE.info
CARGO_LOCK=$LOCK_DIR/ferric-cargo.lock
SLOT0=$LOCK_DIR/ferric-compile.lock
SLOT1=$LOCK_DIR/ferric-compile.2.lock
POLL=${FERRIC_BOX_LEASE_POLL_SECS:-1}
EXPIRED=75 # same status the gate and the shim use for "never got the lock"
DEFAULT_WAIT=28800 # the shim's own 8 h
DEFAULT_MAX_HOLD=14400

die() { echo "box-lease: $*" >&2; exit 2; }

# ERE matching the fdinfo line of a held flock on any of the given files. Same source as
# ferric_cargo_lock_holders (cargo-lock-lib.sh), and for the same reason: /proc/locks can name a pid
# that has exited. Fails if none of the files exists yet.
lock_pattern() {
    local f maj min ino alt=""
    for f in "$@"; do
        read -r maj min ino < <(stat -L -c '%Hd %Ld %i' "$f" 2>/dev/null) || continue
        alt+=$(printf '|%02x:%02x:%s' "$maj" "$min" "$ino")
    done
    [[ -n $alt ]] && printf '^lock:.* (%s) ' "${alt#|}"
}

pid_holds() { # PID ERE
    grep -qsE "$2" "/proc/$1/fdinfo/"*
}

ancestor_holds() { # FILE...
    local pattern p=$PPID stat
    pattern=$(lock_pattern "$@") || return 1
    while ((p > 1)); do
        pid_holds "$p" "$pattern" && return 0
        stat=$(cat "/proc/$p/stat" 2>/dev/null) || return 1
        stat=${stat##*) } # comm may contain spaces; state and ppid follow its ')'
        p=${stat#* }
        p=${p%% *}
    done
    return 1
}

# True when this process runs under a live lease of its own. The env form survives reparenting;
# the ancestor form survives `env -i`. The pid is checked so that a stale value means nothing.
under_own_lease() {
    local pattern
    if [[ -n ${FERRIC_BOX_LEASE_PID:-} ]] && pattern=$(lock_pattern "$LEASE") &&
        pid_holds "$FERRIC_BOX_LEASE_PID" "$pattern"; then
        return 0
    fi
    ancestor_holds "$LEASE"
}

is_busy() { # FILE: true when someone holds it. Shared, so probes do not collide with each other.
    flock -s -n -E "$EXPIRED" "$1" true
    [[ $? -eq $EXPIRED ]]
}

write_info() { # PHASE
    printf '%s\t%s\t%s\t%s\t%s\n' "$LABEL" "$$" "$(date +%s)" "$1" "$MAX_HOLD" >"$INFO.$$" &&
        mv -f "$INFO.$$" "$INFO"
}

holder_text() {
    local label="" pid="" start="" phase="" since=""
    IFS=$'\t' read -r label pid start phase _ <"$INFO" 2>/dev/null
    [[ -n $start ]] && since=$(date -d "@$start" '+%F %T' 2>/dev/null)
    printf '%s (pid %s, %s since %s)' "${label:-unknown}" "${pid:-?}" "${phase:-?}" "${since:-unknown}"
}

# Take the lock on an already-open fd, waiting for the time left. The waiting flock gets every other
# fd closed: killed while pending, this process must not leave it holding the lease.
take() { # FD WHAT
    local fd=$1 what=$2 close="" o left
    flock -n "$fd" && return 0
    echo "box-lease: $LABEL waiting for $what" >&2
    left=$((DEADLINE - $(date +%s)))
    ((left > 0)) || left=0
    for o in 200 201 202 203; do
        [[ $o == "$fd" ]] || close+=" $o>&-"
    done
    eval "flock -o -w $left -E $EXPIRED $fd $close" && return 0
    echo "box-lease: $LABEL gave up waiting for $what after ${WAIT_SECS}s; command NOT run" >&2
    exit "$EXPIRED"
}

cmd_run() {
    LABEL="" WAIT_SECS=$DEFAULT_WAIT MAX_HOLD=${FERRIC_BOX_LEASE_MAX_HOLD:-$DEFAULT_MAX_HOLD}
    while (($#)); do
        case $1 in
            --label) LABEL=${2:-}; shift 2 || die "--label needs a value" ;;
            --wait-secs) WAIT_SECS=${2:-}; shift 2 || die "--wait-secs needs a value" ;;
            --max-hold) MAX_HOLD=${2:-}; shift 2 || die "--max-hold needs a value" ;;
            --) shift; break ;;
            *) die "unknown argument '$1' (usage: box-lease run --label NAME -- CMD...)" ;;
        esac
    done
    [[ -n $LABEL ]] || die "run needs --label NAME"
    (($#)) || die "run needs a command after --"
    [[ $WAIT_SECS =~ ^[0-9]+$ && $MAX_HOLD =~ ^[0-9]+$ ]] || die "--wait-secs and --max-hold take whole seconds"
    LABEL=${LABEL//[$'\t\n']/ }

    if under_own_lease; then
        export FERRIC_HEAVY_LOCK_HELD=1
        exec "$@"
    fi
    # This would wait on its own ancestor forever.
    ancestor_holds "$CARGO_LOCK" "$SLOT0" "$SLOT1" &&
        die "an ancestor holds a compile or cargo lock; take the lease outside it"

    DEADLINE=$(($(date +%s) + WAIT_SECS))
    exec 200>>"$LEASE" 201>>"$CARGO_LOCK" 202>>"$SLOT0" 203>>"$SLOT1" || die "cannot open locks in $LOCK_DIR"

    take 200 "the box lease, held by $(holder_text)"
    trap 'rm -f "$INFO"' EXIT
    write_info draining
    take 201 "the gate's cargo lock"
    take 202 "compile slot 0"
    take 203 "compile slot 1"
    write_info active

    # Cargo under this lease runs straight through the shim: the slots are already ours.
    export FERRIC_BOX_LEASE_PID=$$ FERRIC_HEAVY_LOCK_HELD=1
    "$@" <&0 200>&- 201>&- 202>&- 203>&- &
    local child=$! warned=0
    trap 'kill -TERM "$child" 2>/dev/null' INT TERM HUP
    SECONDS=0
    while kill -0 "$child" 2>/dev/null; do
        if ((!warned && SECONDS >= MAX_HOLD)); then
            echo "box-lease: WARNING: $LABEL has held the box for ${SECONDS}s (--max-hold $MAX_HOLD). Not killing it." >&2
            warned=1
        fi
        sleep "$POLL" 200>&- 201>&- 202>&- 203>&-
    done
    wait "$child"
    exit $?
}

cmd_wait() {
    local wait_secs=$DEFAULT_WAIT
    while (($#)); do
        case $1 in
            --wait-secs) wait_secs=${2:-}; shift 2 || die "--wait-secs needs a value" ;;
            *) die "unknown argument '$1' (usage: box-lease wait [--wait-secs N])" ;;
        esac
    done
    [[ $wait_secs =~ ^[0-9]+$ ]] || die "--wait-secs takes whole seconds"
    under_own_lease && return 0
    # Holding a heavy lock, we are what a pending lease is draining.
    ancestor_holds "$CARGO_LOCK" "$SLOT0" "$SLOT1" && return 0
    if is_busy "$LEASE"; then
        echo "box-lease: waiting for box lease held by $(holder_text)" >&2
        flock -s -w "$wait_secs" -E "$EXPIRED" "$LEASE" true || {
            echo "box-lease: lease still held after ${wait_secs}s" >&2
            exit "$EXPIRED"
        }
    fi
}

cmd_status() {
    local f label pid start phase max age
    if is_busy "$LEASE"; then
        IFS=$'\t' read -r label pid start phase max <"$INFO" 2>/dev/null
        age=$(($(date +%s) - ${start:-$(date +%s)}))
        echo "lease: HELD by $(holder_text), ${age}s"
        ((age >= ${max:-$DEFAULT_MAX_HOLD})) && echo "WARNING: past its max-hold of ${max}s. Nothing kills it; ask its owner."
    else
        echo "lease: free"
    fi
    for f in "$CARGO_LOCK" "$SLOT0" "$SLOT1"; do
        if is_busy "$f"; then echo "$f: held (lsof it for the holder)"; else echo "$f: free"; fi
    done
}

case ${1:-} in
    run) shift; cmd_run "$@" ;;
    wait) shift; cmd_wait "$@" ;;
    status) cmd_status ;;
    *) sed -n '2,8p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
